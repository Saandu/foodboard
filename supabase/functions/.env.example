# Backend-only secrets. Copy to supabase/functions/.env.local (gitignored).
# Never prefix these with VITE_ or put the Gemini key in frontend settings.
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
MENU_IMPORT_ENABLED=true
MENU_IMPORT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173,https://foodboard-demo.web.app,https://foodboard-demo.firebaseapp.com
