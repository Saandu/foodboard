{
  "name": "foodboard",
  "private": true,
  "version": "1.0.0",
  "description": "Digital restaurant menu builder — design a menu in the admin panel, publish it to diners via link or QR code.",
  "type": "module",
  "//engines": "@supabase/supabase-js needs a native WebSocket, which Node gained in 22. On Node 20 scripts/seed.js dies at createClient.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "og:image": "node scripts/og-image.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js",
    "migrate:images": "node scripts/migrate-images.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.3.0",
    "@fortawesome/free-solid-svg-icons": "6.3.0",
    "@fortawesome/vue-fontawesome": "3.0.3",
    "@supabase/supabase-js": "^2.112.3",
    "@vueuse/core": "9.13.0",
    "pinia": "2.0.30",
    "qrcode": "^1.5.4",
    "vue": "3.2.47",
    "vue-i18n": "^9.14.5",
    "vue-router": "4.1.6"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "4.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "sharp": "^0.35.3",
    "vite": "4.1.1",
    "vitest": "^4.1.10"
  }
}
