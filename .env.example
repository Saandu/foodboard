# Supabase project credentials.
# Copy this file to .env and fill in the values from your project's
# API settings: https://supabase.com/dashboard/project/_/settings/api
#
# The publishable (anon) key is safe to ship in a browser bundle. It cannot read
# or write any table: `anon` is revoked from all of them, and the only thing it
# may call is the get_public_menu function. See supabase/migrations/.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Absolute origin used to build shareable menu links and QR codes, so a code
# generated from localhost still resolves for a guest. Defaults to the public
# demo when unset.
VITE_PUBLIC_MENU_ORIGIN=https://foodboard-demo.web.app

# --- Used only by `npm run seed` ---------------------------------------------

# REQUIRED. Row Level Security scopes every table to the signed-in owner, and
# the seed writes rows on behalf of the showcase account, so it cannot run with
# the publishable key. Project Settings -> API Keys -> service_role.
# This key bypasses RLS entirely: never expose it to the browser and never give
# it a VITE_ prefix, or Vite will inline it into the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# The account that owns the showcase restaurants. Set this to the auth user id
# (UUID) of the account you sign in with, or the reset will hand the demo menus
# to a placeholder owner and your dashboard will show an empty workspace.
# Find it in the Supabase dashboard under Authentication -> Users.
SHOWCASE_USER_ID=

# `npm run migrate:images` uses the same two variables above. It moves legacy
# base64 images out of the structures table and into Supabase Storage; run it
# once with --dry-run first.

# --- Used only by the opt-in RLS suite ---------------------------------------

# tests/rls.test.js signs in as two accounts and asserts neither can read or
# write the other's rows. It is skipped unless all four are set. Use throwaway
# accounts that are already confirmed: the suite does not sign anyone up.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
